      color: white;
      text-align: center;
    }

    .container {
      padding: 50px;
    }

    h1 {
      font-size: 40px;
    }

    p {
      font-size: 18px;
      color: #aaa;
    }

    .btn {
      display: inline-block;
      margin: 10px;
      padding: 10px 20px;
      border-radius: 5px;
      text-decoration: none;
      color: white;
      background: #238636;
    }

    .btn:hover {
      background: #2ea043;
    }

    .section {
      margin-top: 50px;
    }

    .card {
      background: #161b22;
      padding: 20px;
      margin: 10px auto;
      width: 300px;
      border-radius: 10px;
    }
  </style>
</head>

<body>

  <div class="container">
    <h1>Hi, I'm Nitin Rajgor 👋</h1>
    <p>BCA Student | Web Developer | Python Learner</p>

    <a class="btn" href="https://github.com/Nitinrajgor07" target="_blank">GitHub</a>
